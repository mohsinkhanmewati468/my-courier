{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": ".",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true
  },
  "monorepo": true,
  "root": ".",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "identity-service": {
      "type": "application",
      "root": "apps/identity-service",
      "entryFile": "main",
      "sourceRoot": "apps/identity-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/identity-service/tsconfig.app.json"
      }
    },
    "job-service": {
      "type": "application",
      "root": "apps/job-service",
      "entryFile": "main",
      "sourceRoot": "apps/job-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/job-service/tsconfig.app.json"
      }
    },
    "my-courier": {
      "type": "application",
      "root": "apps/my-courier",
      "entryFile": "main",
      "sourceRoot": "apps/my-courier/src",
      "compilerOptions": {
        "tsConfigPath": "apps/my-courier/tsconfig.app.json"
      }
    }
  }
}